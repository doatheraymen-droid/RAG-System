APP_NAME=MyRAGSystem
APP_VERSION=1.0.0
CHUNK_SIZE=500
CHUNK_OVERLAP=50
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# LLM Provider Configuration
LLM_PROVIDER=ollama
# Options: ollama, openai, huggingface

# Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# OpenAI Settings (if using)
OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-3.5-turbo

# Hugging Face Settings (if using)
HUGGINGFACE_API_KEY=your-key-here
HF_MODEL=google/flan-t5-small

# ===== Bonus 1: LLM Factory Configuration =====
LLM_PROVIDER=ollama
# Options: ollama, openai, huggingface

# Ollama Settings (Free, Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# OpenAI Settings (Paid - optional)
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-3.5-turbo

# Hugging Face Settings (Free - optional)
HUGGINGFACE_API_KEY=your-hf-key-here
HF_MODEL=google/flan-t5-small

# ===== Chunking Settings =====
CHUNK_SIZE=500
CHUNK_OVERLAP=50